# Don't fill this in by hand — run `./setup.sh` instead, which copies this
# to .env and auto-generates every value below except SITE_URL (that one
# genuinely can't be guessed for you). Never commit the real .env — it's
# already git-ignored.
#
# The manual instructions below are only here for reference (e.g. if you
# can't run a shell script for some reason) — most people should never
# need to read past this line.

# --- Postgres ---
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Auth secrets ---
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`
# ANON_KEY / SERVICE_ROLE_KEY: HS256 JWTs signed with JWT_SECRET, payloads
# {"role":"anon","iss":"supabase"} and {"role":"service_role","iss":"supabase"}
# respectively — this is exactly what setup.sh generates for you.
JWT_SECRET=change-me
JWT_EXP=3600
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
# (The frontend's own copy of ANON_KEY is derived from it at container
# start — there is nothing else to keep in sync.)

# CRON_SECRET: any random string, e.g. `openssl rand -hex 32` — shared
# between the notification-cron migration and the app container's edge
# runtime so only Postgres can trigger a notification sweep.
CRON_SECRET=change-me

# --- The one thing you actually have to set ---
# The public URL this instance will be served at. Used both for auth
# config and as the frontend's API base — one origin for everything now
# that auth/rest/functions/frontend all live behind the same gateway.
SITE_URL=https://your-domain.example

# --- App port (default is fine for most setups) ---
APP_PORT=8080

# --- Optional: pin the image version ---
# Defaults to the latest release. Set to a specific tag (e.g. v1.0.0) to
# control when upgrades happen; `docker compose pull && docker compose up -d`
# then moves you forward on your own schedule.
# SYLLABASE_VERSION=latest
