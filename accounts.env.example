# Copy this to accounts.env (git-ignored). This is the entire account
# system for this self-hosted instance — there is no public signup page.
#
# Format: username:password pairs, comma-separated. Applied automatically
# every time you run `docker compose up` (via the seed-accounts service).
#
# To reset a password: change it here and run
#   docker compose up -d seed-accounts
# again — no email, no SMTP, no admin panel needed.

ACCOUNTS=alice:change-this-password,bob:change-this-too
