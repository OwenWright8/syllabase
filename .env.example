# NOTHING IN THIS FILE IS REQUIRED.
#
# A fresh Syllabase install needs no configuration: `docker compose up -d`
# generates its own secrets on first start and keeps them in the `secrets`
# volume. You do not need a .env file at all.
#
# Only use this to override something. Docker Compose reads a file named `.env`
# next to docker-compose.yml automatically, so: copy this to `.env`, uncomment
# what you want, leave the rest.
#
# Setting a secret yourself takes precedence over the generated one. Changing
# POSTGRES_PASSWORD after the database has been created does NOT change the
# database's real password.

# --- Use your own secrets instead of generated ones -----------------------------
# POSTGRES_PASSWORD=          # no @ : / ? # % [ ] or whitespace (it goes into URLs)
# JWT_SECRET=                 # at least 32 characters, e.g. `openssl rand -hex 32`
# CRON_SECRET=                # any random string, e.g. `openssl rand -hex 32`
# ANON_KEY=                   # HS256 JWTs signed with JWT_SECRET, payloads
# SERVICE_ROLE_KEY=           # {"role":"anon"} / {"role":"service_role"}; derived from JWT_SECRET if unset

# --- Course materials (uploaded textbooks and syllabi) -------------------------
# Uploads and the OCR worker are ON by default. Files are stored in the
# database (so they are included in your backups) and are limited per account.
# DOCUMENTS=on                # "off" turns uploads and the worker off
# DOCUMENT_MAX_FILE_MB=200    # largest single file (a number, or "unlimited")
# DOCUMENT_USER_QUOTA_MB=1024 # total per user (a number, or "unlimited")
# DOCUMENT_MAX_COUNT=200      # most documents per user (a number, or "unlimited")

# --- Port ------------------------------------------------------------------------
# The port the app is published on (host side). Default 8080.
# APP_PORT=8080

# --- Pin the version --------------------------------------------------------------
# Defaults to the latest release. Set a tag (e.g. v0.4.0) to control when
# upgrades happen; `docker compose pull && docker compose up -d` then moves you
# forward on your own schedule.
# SYLLABASE_VERSION=latest
