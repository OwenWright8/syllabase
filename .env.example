# Don't fill this in by hand — run `./setup.sh` instead, which copies this
# to .env and auto-generates every value below except the two domain
# names at the bottom (those can't be guessed for you). Never commit the
# real .env — it's already git-ignored.
#
# The manual instructions below are only here for reference (e.g. if you
# can't run a shell script for some reason) — most people should never
# need to read past this line.

# --- Postgres ---
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Auth secrets ---
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`
# ANON_KEY / SERVICE_ROLE_KEY: HS256 JWTs signed with JWT_SECRET, payloads
# {"role":"anon","iss":"supabase"} and {"role":"service_role","iss":"supabase"}
# respectively — this is exactly what setup.sh generates for you.
JWT_SECRET=change-me
JWT_EXP=3600
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me

# CRON_SECRET: any random string, e.g. `openssl rand -hex 32` — shared
# between the notification-cron migration and the send-notifications
# function so only Postgres can trigger it.
CRON_SECRET=change-me

# --- Networking (you still need to set these two by hand) ---
# The public URL your frontend will be served at.
SITE_URL=https://your-domain.example
KONG_HTTP_PORT=8000
FRONTEND_PORT=8080

# --- Frontend runtime config ---
# VITE_SUPABASE_URL should be the public URL your Kong gateway is reachable
# at (e.g. a reverse-proxied api.your-domain.example -> localhost:8000).
# Read at container *start* (not baked into the build), so changing this
# just needs a container restart, not a rebuild.
# VITE_SUPABASE_PUBLISHABLE_KEY: paste the same value as ANON_KEY above —
# .env files don't expand ${VARS} written inside them, so it must be a
# literal copy, not a reference (setup.sh does this for you).
VITE_SUPABASE_URL=https://api.your-domain.example
VITE_SUPABASE_PUBLISHABLE_KEY=change-me
